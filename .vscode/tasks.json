{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run C++",
            "type": "shell",
            "command": "g++ -std=c++17 -O2 -I ${workspaceFolder}/.vscode/include -o ${fileDirname}/${fileBasenameNoExtension} ${file} && ${fileDirname}/${fileBasenameNoExtension}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compile and run active C++ file with system g++ (clang)",
            "presentation": {
                "reveal": "always",
                "focus": true
            }
        }
    ]
}
